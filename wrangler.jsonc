{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dishly-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-05-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
  "vars": { "DEPLOYMENT_ENV": "production" },
  "secrets": {
    "required": ["SUPABASE_URL", "SUPABASE_KEY", "DEPLOY_PROBE_TOKEN"],
  },
  "r2_buckets": [
    { "binding": "PDF_BUCKET", "bucket_name": "dishly-pdf-imports-eu", "jurisdiction": "eu" },
  ],
  "queues": {
    "producers": [{ "binding": "PDF_IMPORT_QUEUE", "queue": "dishly-pdf-imports" }],
  },
  "env": {
    "preview": {
      "name": "dishly-web-preview",
      "preview_urls": true,
      "vars": { "DEPLOYMENT_ENV": "preview" },
      "secrets": { "required": [] },
      "r2_buckets": [],
      "queues": { "producers": [] },
    },
  },
}
