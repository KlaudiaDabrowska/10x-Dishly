# Restricted F-01 PDF validation experiment. Missing values keep it disabled.
PDF_VALIDATION_ENABLED=false
# Comma-separated Supabase auth user IDs allowed to run the experiment.
PDF_VALIDATION_EVALUATOR_IDS=###
