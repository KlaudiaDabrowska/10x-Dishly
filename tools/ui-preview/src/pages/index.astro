---
import DashboardView from "@/components/dashboard/DashboardView.astro";
import ImportOutcomeFeedback from "@/components/dashboard/ImportOutcomeFeedback";
import ComponentPreview from "../components/ComponentPreview";
import RecipeDecisionPreview from "../components/RecipeDecisionPreview";
import "../styles/preview.css";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dishly UI preview</title>
    <script is:inline>
      const parameters = new URLSearchParams(location.search);
      document.documentElement.classList.toggle("dark", parameters.get("theme") === "dark");
      const requestedView = parameters.get("view");
      document.documentElement.dataset.previewView =
        requestedView === "dashboard" || requestedView === "decisions" ? requestedView : "components";
      document.documentElement.dataset.importAvailability =
        parameters.get("import") === "unavailable" ? "unavailable" : "available";
      document.documentElement.dataset.feedbackState = parameters.get("feedback") ?? "confirmed";
      document.documentElement.dataset.capture = parameters.get("capture") ?? "preview";
      document.documentElement.dataset.decisionState = parameters.get("decision") ?? "all";
    </script>
  </head>
  <body data-ui-preview>
    <main class="min-h-screen bg-background px-4 py-10 text-foreground sm:px-8" data-component-preview>
      <ComponentPreview />
    </main>
    <main class="min-h-screen bg-background px-4 py-10 text-foreground sm:px-8" data-decision-preview>
      <RecipeDecisionPreview />
    </main>
    <div data-dashboard-preview>
      <div data-dashboard-variant="available">
        <DashboardView email="bardzo.dlugi.adres.email.uzytkownika@przykladowa-domena.example" importAvailable={true}>
          <div slot="feedback" data-feedback-variant="pending">
            <ImportOutcomeFeedback state="pending" />
          </div>
          <div slot="feedback" data-feedback-variant="confirmed">
            <ImportOutcomeFeedback state="confirmed" saved={3} alreadySaved={1} />
          </div>
          <div slot="feedback" data-feedback-variant="unavailable">
            <ImportOutcomeFeedback state="unavailable" />
          </div>
        </DashboardView>
      </div>
      <div data-dashboard-variant="unavailable">
        <DashboardView
          email="bardzo.dlugi.adres.email.uzytkownika@przykladowa-domena.example"
          importAvailable={false}
        />
      </div>
    </div>
  </body>
</html>
