{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local PDF reference results v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "fixtureId", "sourceSha256", "review", "recipes"],
  "properties": {
    "version": {
      "const": 1
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approvedAt", "approvedBy"],
      "properties": {
        "status": {
          "enum": ["pending", "approved"]
        },
        "approvedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "approvedBy": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "category",
          "sourceCategory",
          "pages",
          "anchors",
          "ingredientGroups",
          "instructions",
          "servings",
          "footnotes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "category": {
            "enum": ["breakfast", "lunch", "dinner", "dessert"]
          },
          "sourceCategory": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "anchors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "text", "occurrence"],
              "properties": {
                "page": {
                  "type": "integer",
                  "minimum": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "occurrence": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "minItems": 1
          },
          "ingredientGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "ingredients"],
              "properties": {
                "label": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ingredients": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "quantity", "unit", "sourceText"],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "quantity": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "unit": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sourceText": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "servings": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "footnotes": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          }
        }
      },
      "minItems": 1
    }
  }
}
