---
import Layout from "@/layouts/Layout.astro";
import RecipeImportPanel from "@/components/pdf-processing/RecipeImportPanel";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { productImportAvailable } from "@/lib/pdf-validation";

const available = productImportAvailable();
---

<Layout title="Import przepisów z PDF | Dishly">
  <main class="min-h-screen bg-background px-4 py-8 text-foreground sm:px-6 sm:py-12">
    <div class="mx-auto w-full max-w-4xl">
      <header class="flex flex-col gap-2">
        <a href="/dashboard" class:list={[buttonVariants({ variant: "link" }), "w-fit px-0"]}>
          Wróć do swoich przepisów
        </a>
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Import przepisów z PDF</h1>
        <p class="text-sm text-muted-foreground">
          Dodaj kompletne przepisy automatycznie i zdecyduj, co zrobić z niekompletnymi.
        </p>
      </header>

      {available ? (
        <RecipeImportPanel client:load />
      ) : (
        <Card className="mt-8 text-center">
          <CardHeader>
            <CardTitle>Import PDF jest teraz niedostępny</CardTitle>
            <CardDescription>Spróbuj ponownie później.</CardDescription>
          </CardHeader>
          <CardContent>
            <a href="/dashboard" class:list={[buttonVariants({ variant: "outline" })]}>
              Wróć do kolekcji
            </a>
          </CardContent>
        </Card>
      )}
    </div>
  </main>
</Layout>
